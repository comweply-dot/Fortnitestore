# Port for Node.js Express server (default: 3000)
PORT=3000

# Environment mode: development or production
NODE_ENV=production

# App URL for hosting / custom GoDaddy domain (e.g. https://yourfortnitestore.com)
APP_URL="http://localhost:3000"

# Optional: Custom Admin Portal Password (default in code is FortniteAdmin2026!)
ADMIN_PASSWORD="YourSecurePasswordHere"

# Optional: Gemini API Key if AI features are enabled
GEMINI_API_KEY=""

